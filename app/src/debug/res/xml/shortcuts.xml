<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="voice_add"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_voice"
        android:shortcutShortLabel="@string/shortcut_voice_short"
        android:shortcutLongLabel="@string/shortcut_voice_long">
        <intent
            android:action="com.litetask.app.SHORTCUT_VOICE_ADD"
            android:targetPackage="com.litetask.app.debug"
            android:targetClass="com.litetask.app.MainActivity">
            <extra android:name="action" android:value="voice_add" />
        </intent>
    </shortcut>

    <shortcut
        android:shortcutId="text_add"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_text"
        android:shortcutShortLabel="@string/shortcut_text_short"
        android:shortcutLongLabel="@string/shortcut_text_long">
        <intent
            android:action="com.litetask.app.SHORTCUT_TEXT_ADD"
            android:targetPackage="com.litetask.app.debug"
            android:targetClass="com.litetask.app.MainActivity">
            <extra android:name="action" android:value="text_add" />
        </intent>
    </shortcut>

    <shortcut
        android:shortcutId="manual_add"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_manual"
        android:shortcutShortLabel="@string/shortcut_manual_short"
        android:shortcutLongLabel="@string/shortcut_manual_long">
        <intent
            android:action="com.litetask.app.SHORTCUT_MANUAL_ADD"
            android:targetPackage="com.litetask.app.debug"
            android:targetClass="com.litetask.app.MainActivity">
            <extra android:name="action" android:value="manual_add" />
        </intent>
    </shortcut>
</shortcuts>

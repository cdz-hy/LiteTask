<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:paddingBottom="16dp">

    <!-- 紧凑标题栏（与真实 widget_task_list.xml 一致） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_widget_task"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="@string/widget_task_list_title"
            android:textColor="@color/on_surface"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:background="@drawable/widget_badge_background"
            android:text="@string/widget_filter_all"
            android:textColor="@color/on_surface_variant"
            android:textSize="10sp"
            android:textStyle="bold"
            android:maxLines="1" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:padding="2dp"
            android:src="@drawable/ic_widget_add"
            android:contentDescription="@null" />
    </LinearLayout>

    <!-- 列表容器（paddingHorizontal=8dp 与 ListView 一致） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="8dp">

        <!-- 预览项1: 置顶工作任务 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_item_background"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp"
            android:layout_marginTop="1dp"
            android:layout_marginBottom="3dp">

            <ImageView
                android:layout_width="3dp"
                android:layout_height="24dp"
                android:src="@drawable/widget_type_indicator_work"
                android:scaleType="fitXY"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="完成项目周报"
                    android:textColor="@color/on_surface"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="14:00-16:00"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="10sp"
                    android:maxLines="1" />
            </LinearLayout>

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginEnd="4dp"
                android:src="@drawable/ic_widget_pin"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:paddingHorizontal="4dp"
                android:paddingVertical="1dp"
                android:background="@drawable/widget_badge_work"
                android:text="@string/task_type_work"
                android:textColor="@android:color/white"
                android:textSize="8sp" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/widget_checkbox_unchecked"
                android:contentDescription="@null" />
        </LinearLayout>

        <!-- 预览项2: 学习任务 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_item_background"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp"
            android:layout_marginTop="1dp"
            android:layout_marginBottom="3dp">

            <ImageView
                android:layout_width="3dp"
                android:layout_height="24dp"
                android:src="@drawable/widget_type_indicator_study"
                android:scaleType="fitXY"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Kotlin 协程学习"
                    android:textColor="@color/on_surface"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="19:00-21:00"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="10sp"
                    android:maxLines="1" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:paddingHorizontal="4dp"
                android:paddingVertical="1dp"
                android:background="@drawable/widget_badge_study"
                android:text="@string/task_type_study"
                android:textColor="@android:color/white"
                android:textSize="8sp" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/widget_checkbox_unchecked"
                android:contentDescription="@null" />
        </LinearLayout>

        <!-- 预览项3: 已过期任务 (60% 透明度效果，与 TaskListWidgetService 一致) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_item_background"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp"
            android:layout_marginTop="1dp"
            android:layout_marginBottom="3dp"
            android:alpha="0.6">

            <ImageView
                android:layout_width="3dp"
                android:layout_height="24dp"
                android:src="@drawable/widget_type_indicator_done"
                android:scaleType="fitXY"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="发送周报邮件"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="11/12 17:30"
                    android:textColor="@color/outline"
                    android:textSize="10sp"
                    android:maxLines="1" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:paddingHorizontal="4dp"
                android:paddingVertical="1dp"
                android:background="@drawable/widget_urgent_badge"
                android:text="@string/expired_tasks_header"
                android:textColor="@android:color/white"
                android:textSize="8sp" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/widget_checkbox_unchecked"
                android:contentDescription="@null" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
